{
  "name": "grove-ui",
  "private": true,
  "type": "module",
  "description": "Grove's browser UI: injected into Chromium's WebUI browser (Webium)",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node launcher/grove.mjs --dev",
    "start": "node build.mjs && node launcher/grove.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.48.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
