{
  "manifest_version": 3,
  "name": "Grove bridge",
  "description": "Lets Grove's host move and manage tabs across windows, see downloads, ask for sites' permissions and install extensions from the Web Store. Loaded by the Grove launcher.",
  "version": "0.1.0",
  "permissions": [
    "tabs",
    "contentSettings",
    "downloads",
    "downloads.open",
    "sessions",
    "idle",
    "history",
    "management",
    "bookmarks",
    "browsingData",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "grove-bridge.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "permissions-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "permissions-relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "translate.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "new-blank-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "New blank window"
    }
  }
}
